# Local preview runs without any keys using persistent PGlite PostgreSQL.
# For a production deployment, use managed PostgreSQL and Supabase Auth.
DATABASE_URL=
DATABASE_DIR=
DATABASE_SSL=require
DATABASE_AUTO_MIGRATE=false
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:4317
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Keep false in public deployments. Enables local preview accounts with next start.
ALLOW_LOCAL_AUTH=false
# Production requires staff MFA regardless of this local/staging opt-in flag.
STAFF_MFA_REQUIRED=false
# Server-only 32-byte base64 AES key; required with managed DB or production.
# Local PGlite uses a private key file in DATABASE_DIR when this is empty.
MFA_ENCRYPTION_KEY=
# Optional future Kling video generation; generation is pending user setup.
FAL_KEY=
COMMERCE_MAINTENANCE_SECRET=
# HTTP worker uses the running server; do not open the same PGlite DB in another process.
COMMERCE_MAINTENANCE_URL=http://127.0.0.1:4317/api/internal/maintenance
COMMERCE_MAINTENANCE_INTERVAL_MS=60000
# Server-only Shiprocket access: a token, or API-user email and password.
SHIPROCKET_TOKEN=
COURIER_WEBHOOK_TOKEN=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Public indexing is opt-in after release approval; staging stays noindex.
DEPLOYMENT_ENV=local
SITE_INDEXING_ENABLED=false
